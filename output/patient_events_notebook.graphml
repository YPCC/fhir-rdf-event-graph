    </edge>
    <edge source="Encounter/1" target="Procedure/1">
      <data key="d3">hasNextEvent</data>
    </edge>
    <edge source="Procedure/1" target="Procedure/2">
      <data key="d3">hasNextEvent</data>
    </edge>
    <edge source="Procedure/2" target="MedicationAdministration/1">
      <data key="d3">hasNextEvent</data>
